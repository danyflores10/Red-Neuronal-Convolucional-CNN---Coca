# ============================================================
#  API de Reconocimiento de Hoja de Coca - ADEPCOCA
#  Copia este archivo como .env (instalar.bat lo hace solo) y ajusta los valores.
#  Una variable vacía usa el valor por defecto.
# ============================================================

# --- Servidor ---
HOST=127.0.0.1
PORT=5000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Clave compartida con Laravel (encabezado X-API-Key). Vacía = sin clave (solo para desarrollo).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Orígenes que pueden llamar a la API desde el navegador (Laravel la llama desde el servidor, no hace falta CORS)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Modelo entrenado en Colab (contenido de modelo_coca_api.zip) ---
MODELO_PATH=weights/best.pt
MODELO_META_PATH=weights/model_meta.json
OOD_PATH=weights/ood_embeddings.npz
CLASES_PATH=config/clases.json
# cpu | auto (usa GPU NVIDIA si existe) | cuda:0
DEVICE=cpu
# Vacíos = los valores que recomendó el notebook (model_meta.json)
IMGSZ=
TTA=
UMBRAL_CONFIANZA_ALTA=
UMBRAL_CONFIANZA_MINIMA=
UMBRAL_CONSISTENCIA=0.6
# Mapas de atención (Grad-CAM): muestran en qué zonas de la hoja se fijó la red
MAPAS_ATENCION=true
# Nombre de la clase "no es hoja de coca" si usaste uno distinto a no_es_coca / otro / fondo (separados por coma)
CLASES_RECHAZO=

# --- Límites por petición ---
MAX_IMAGENES=10
MAX_MB_POR_IMAGEN=10

# --- Guardar las fotos analizadas para re-entrenar (revisa la privacidad antes de activarlo) ---
GUARDAR_CAPTURAS=false
CAPTURAS_DIR=data/capturas
